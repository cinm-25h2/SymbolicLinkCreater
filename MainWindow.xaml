<Window x:Class="SymbolicLinkCreater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SymbolicLinkCreater"
        mc:Ignorable="d"
        xmlns:properties="clr-namespace:SymbolicLinkCreater.Properties"
        Title="Symbolic Link Creater"
        Height="450"
        Width="800"
        MinHeight="460"
        MinWidth="700">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid
            Height="100"
            Grid.Row="0"
            VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <Label Content="{x:Static properties:Resources.Label_WindowTitle}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Height="26"
                   Grid.Column="0"
                   Grid.Row="0"/>

            <Label Content="{x:Static properties:Resources.Label_LinkPath}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Height="26"
                   Grid.Row="2"/>
            <TextBox x:Name="txtLinkPath"
                     Text="C:\example\LinkPath"
                     TextChanged="TextBox_TextChanged"
                     VerticalAlignment="Center"
                     TextWrapping="NoWrap"
                     Margin="10,0,40,0"
                     Width="Auto"
                     Height="20"
                     Grid.Column="1"
                     Grid.Row="2"/>
            <Button x:Name="btnLinkePath"
                    Content="..."
                    Click="FilePicker_Link"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Margin="0,0,20,0"
                    Width="20"
                    Height="20"
                    Grid.Column="1"
                    Grid.Row="2"/>

            <Label Content="{x:Static properties:Resources.Label_TargetPath}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Height="26"
                   Grid.Row="3"/>
            <TextBox x:Name="txtTargetPath"
                     Text="C:\example\TargetPath"
                     TextChanged="TextBox_TextChanged"
                     VerticalAlignment="Center"
                     TextWrapping="NoWrap"
                     Margin="10,0,40,0"
                     Width="Auto"
                     Height="20"
                     Grid.Column="1"
                     Grid.Row="3"/>
            <Button x:Name="btnTargetPath"
                    Content="..."
                    Click="FilePicker_Target"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Margin="0,0,20,0"
                    Width="20"
                    Height="20"
                    Grid.Column="1"
                    Grid.Row="3"/>
        </Grid>
        <Grid
            Grid.Row="1"
            Margin="130,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>

            <RadioButton x:Name="chkboxForDefault"
                      GroupName="Options"
                      Content="{x:Static properties:Resources.chkbox_ForDefault}"
                      IsChecked="True"
                      Click="CheckBox_Click"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Left"
                      Grid.Column="0"/>
            <RadioButton x:Name="chkboxForDirectory"
                      GroupName="Options"
                      Content="{x:Static properties:Resources.chkbox_ForDirectory}"
                      IsChecked="False"
                      Click="CheckBox_Click"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Left"
                      Grid.Column="1"/>
            <RadioButton x:Name="chkboxForHardlink"
                      GroupName="Options"
                      Content="{x:Static properties:Resources.chkbox_ForHardlink}"
                      IsChecked="False"
                      Click="CheckBox_Click"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Left"
                      Grid.Column="2"/>
            <RadioButton x:Name="chkboxForDirJunction"
                      GroupName="Options"
                      Content="{x:Static properties:Resources.chkbox_ForDirJunction}"
                      IsChecked="False"
                      Click="CheckBox_Click"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Left"
                      Grid.Column="3"/>
        </Grid>
        <Grid
            Grid.Row="2"
            Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="{x:Static properties:Resources.Label_Command}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Height="26"
                   Grid.Column="0"/>
            <TextBox x:Name="txtbox_Command"
                     Text="{x:Static properties:Resources.txtbox_cmdmessage}"
                     VerticalAlignment="Center"
                     TextWrapping="NoWrap"
                     IsReadOnly="True"
                     Margin="10,0,20,0"
                     Width="Auto"
                     Height="20"
                     Grid.Column="1"/>

        </Grid>
        <Border
            BorderBrush="Gray"
            BorderThickness="0.25"
            VerticalAlignment="Bottom"
            Margin="0,0,0,-5"
            Grid.Row="2"
            Grid.ColumnSpan="2"/>
        <Grid
            Grid.Row="3"
            Margin="0,5,0,0"
            VerticalAlignment="Stretch"
            Height="Auto"
            Width="Auto"
            MinHeight="210">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="{x:Static properties:Resources.Label_CommandLog}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Height="26"
                   Margin="0,10,0,0"
                   Grid.Column="0"/>
            <TextBox x:Name="txtbox_CommandLog"
                     Text="{x:Static properties:Resources.txtbox_cmdlogmessage}"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     TextWrapping="Wrap"
                     IsReadOnly="True"
                     Margin="10,10,20,10"
                     Width="Auto"
                     Height="Auto"
                     Grid.Column="1"/>

        </Grid>
        <Grid
            Grid.Row="4"
            Height="30"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Right"
            Margin="0,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnAbout"
                    Content="{x:Static properties:Resources.btn_About}"
                    Click="btn_About"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="60"
                    Height="20"
                    Grid.Column="0"/>
            <Button x:Name="btnExit"
                    Content="{x:Static properties:Resources.btn_Exit}"
                    Click="btn_Exit"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="60"
                    Height="20"
                    Grid.Column="1"/>
            <Button x:Name="btnStart"
                    Content="{x:Static properties:Resources.btn_Start}"
                    Click="btn_Start"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="60"
                    Height="20"
                    Grid.Column="2"/>
        </Grid>

    </Grid>
</Window>